{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pheonix-Studio-cat/Chinook-security/schema/finding.schema.json",
  "title": "Chinook Security finding report",
  "description": "The shared format of all Chinook Security bots. A finding never carries the value that was found.",
  "type": "object",
  "required": ["schema_version", "bot", "generated_at", "summary", "findings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1" },
    "bot": { "type": "string", "description": "name of the bot, e.g. secret-bot" },
    "generated_at": { "type": "string", "description": "UTC, ISO 8601" },
    "target": { "type": "object", "description": "what was checked" },
    "summary": {
      "type": "object",
      "required": ["total", "by_severity"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "by_severity": {
          "type": "object",
          "propertyNames": { "enum": ["critical", "high", "medium", "low", "info"] },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "bot", "rule", "title", "severity", "confidence",
          "location", "explanation", "remediation", "fingerprint"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "description": "bot/rule" },
          "bot": { "type": "string" },
          "rule": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "confidence": { "enum": ["high", "medium", "low"] },
          "location": {
            "type": "object",
            "required": ["path", "line"],
            "properties": {
              "path": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 }
            }
          },
          "explanation": { "type": "string", "description": "why this is a problem" },
          "remediation": { "type": "string", "description": "what fixes it" },
          "evidence": {
            "type": "string",
            "description": "describes the find, never reproduces it -- rule name and length, nothing else"
          },
          "fingerprint": {
            "type": "string",
            "description": "sha256 over bot, rule, path and line -- deliberately without the find"
          }
        }
      }
    }
  }
}
